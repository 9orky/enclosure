{{ module.class }}Error = errors.{{ module.class }}Error
{{ module.class }}Item = models.{{ module.class }}Item
{{ module.class }}Report = reports.{{ module.class }}Report
sort_{{ module.snake }}_items = policies.sort_{{ module.snake }}_items
