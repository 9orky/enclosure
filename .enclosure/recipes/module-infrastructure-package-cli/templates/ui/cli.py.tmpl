from __future__ import annotations

from typing import Annotated

import typer

from enclosure.shared import ui

from .. import application

app = typer.Typer(
    help="Run the {{ target.name }} module command.",
    invoke_without_command=True,
)


@app.callback()
@ui.command_error_boundary
def {{ target.snake }}_command(
    llm: Annotated[
        bool,
        typer.Option("--llm", help="Print LLM-focused guidance for this command."),
    ],
    docs: Annotated[
        bool,
        typer.Option("--docs", help="Print human-focused documentation for this command."),
    ],
) -> None:
    if llm:
        ui.render_llm("llm.tmpl")
        return
    if docs:
        ui.render_docs("docs.tmpl")
        return

    ui.render(application.describe_{{ target.snake }}(), template_name="report.tmpl", context={})


ui.set_command_defaults({{ target.snake }}_command, {"llm": False, "docs": False})


__all__ = ["app"]
