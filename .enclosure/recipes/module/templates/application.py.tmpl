from __future__ import annotations

from . import domain, infrastructure


def describe_{{ target.snake }}() -> domain.{{ target.class }}Report:
    workspace_name = infrastructure.current_workspace_name()
    return domain.{{ target.class }}Report(
        title="{{ target.class }} Report",
        module_path="{{ target.path }}",
        workspace_name=workspace_name,
    )


__all__ = ["describe_{{ target.snake }}"]
