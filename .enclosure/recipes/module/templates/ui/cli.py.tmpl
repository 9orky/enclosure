from __future__ import annotations

from pathlib import Path
from typing import Annotated

import typer

from .. import application

app = typer.Typer(
    help="Run the {{ target.name }} module command.",
    invoke_without_command=True,
)


@app.callback()
def {{ target.snake }}_command(
    llm: Annotated[
        bool,
        typer.Option("--llm", help="Print LLM-focused guidance for this command."),
    ] = False,
    docs: Annotated[
        bool,
        typer.Option("--docs", help="Print human-focused documentation for this command."),
    ] = False,
) -> None:
    if llm:
        typer.echo(_read_template("llm.tmpl"))
        return
    if docs:
        typer.echo(_read_template("docs.tmpl"))
        return

    typer.echo(_render_report(application.describe_{{ target.snake }}()))


def _read_template(name: str) -> str:
    return (Path(__file__).with_name("templates") / name).read_text(encoding="utf-8").strip()


def _render_report(report: object) -> str:
    lines = [f"{report.title}:"]
    lines.extend(f"- {line}" for line in report.lines())
    return "\n".join(lines)


__all__ = ["app"]
