from __future__ import annotations

from . import domain, infrastructure


def build_{{ target.snake }}_report() -> domain.{{ target.class }}Report:
    return domain.{{ target.class }}Report.from_lines(
        title="{{ target.class }} Report",
        lines=(
            "module={{ target.path }}",
            "workspace=" + infrastructure.current_workspace_name(),
            "archetype=module-domain-package-infrastructure-cli",
        ),
    )


__all__ = ["build_{{ target.snake }}_report"]
