from __future__ import annotations

from pathlib import Path

from ..domain import manifest, reference
from . import manifests


class File{{ target.class }}Repository:
    def __init__(self, root_path: Path) -> None:
        self.root_path = Path(root_path)

    def find_all(self) -> tuple[reference.{{ target.class }}Reference, ...]:
        if not self.root_path.is_dir():
            return ()
        return tuple(
            self._reference_for(manifest_path)
            for manifest_path in sorted(self._iter_manifest_paths())
        )

    def get_by_name(self, name: str) -> reference.{{ target.class }}Reference:
        manifest_path = _recipe_manifest_path(self.root_path / name)
        if not manifest_path.is_file():
            raise LookupError(name)
        return self._reference_for(manifest_path)

    def _iter_manifest_paths(self):
        for child in self.root_path.iterdir():
            if child.name.startswith("."):
                continue
            manifest_path = _recipe_manifest_path(child)
            if child.is_dir() and manifest_path.is_file():
                yield manifest_path

    def _reference_for(self, manifest_path: Path) -> reference.{{ target.class }}Reference:
        manifests.load_{{ target.snake }}_manifest(manifest_path)
        return reference.{{ target.class }}Reference(
            name=manifest.manifest_identity(manifest_path),
            root_path=manifest_path.parent,
        )


def _recipe_manifest_path(recipe_root: Path) -> Path:
    return recipe_root / "recipe.yaml"


__all__ = ["File{{ target.class }}Repository"]
